{
  "name": "api-response-util",
  "version": "1.1.0",
  "description": "Tiny Express helpers for consistent API success and error JSON responses.",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/response.test.js",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsup src/index.js --format cjs --clean --sourcemap"
  },
  "keywords": [
    "express",
    "api",
    "response",
    "json",
    "success",
    "error",
    "http",
    "rest",
    "express-middleware",
    "api-response",
    "response-handler",
    "http-status",
    "rest-api",
    "error-handling",
    "nodejs",
    "standardized-response"
  ],
  "author": "anilachary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/api-response-util.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/api-response-util/issues"
  },
  "homepage": "https://github.com/theinfyark/api-response-util#readme",
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "module": "./src/index.js",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "browserslist": ">=4.28.7",
    "brace-expansion": ">=2.1.4"
  }
}
